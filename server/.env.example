# DSRS server configuration
# Copy to server/.env and fill in values.

# Local MySQL (XAMPP) defaults
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dsrs_db

# Enable when the database requires TLS (e.g. TiDB Cloud Serverless)
# DB_SSL=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# HTTP
PORT=5000

# Provisioning (cloud): run `npm run db:provision` to create schema,
# demo users and sample inventory. Always set a strong ADMIN_PASSWORD in cloud.
# ADMIN_PASSWORD=sup3r-secret
# DEMO_USERNAME=demo
# DEMO_PASSWORD=demo2026
# SEED_SAMPLE_SOURCES=1