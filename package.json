{
  "name": "dsrs-app",
  "version": "1.0.0",
  "description": "Disused Sealed Radioactive Sources - Radioactive Source Inventory & Tracking",
  "main": "electron/main.js",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "start": "node server/index.js",
    "start:electron": "electron .",
    "rebuild:electron": "cd server && npx electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "cd server && npm rebuild better-sqlite3",
    "db:init": "cd server && npm run db:init",
    "db:seed": "cd server && npm run db:seed",
    "db:provision": "cd server && npm run db:provision",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0"
  }
}
